FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TIKTOKEN_CACHE_DIR=/app/.tiktoken

WORKDIR /app

COPY requirements-demo.txt .
# The pip cache mount keeps finished downloads between builds; timeout and retries help on slow links.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 120 --retries 10 -r requirements-demo.txt

RUN useradd --create-home --uid 1000 demo && mkdir -p /app/.tiktoken /data && chown -R demo /app /data
USER demo

# Bake the tokenizer file and Chroma's default embedding model into the image (no download at start).
# fetch_embedding_model.py resumes and retries, because Chroma's own downloader times out on slow links.
COPY --chown=demo docker/fetch_embedding_model.py /tmp/fetch_embedding_model.py
RUN python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')" && \
    python /tmp/fetch_embedding_model.py && \
    python -c "from chromadb.utils.embedding_functions import DefaultEmbeddingFunction as E; E()(['warm up'])"

# demo_rag/ and gateway/ reach the guard only through client/ (Architecture.md section 5).
COPY --chown=demo client/ client/
COPY --chown=demo demo_rag/ demo_rag/
COPY --chown=demo gateway/ gateway/

ENV CHROMA_PATH=/data/chroma
EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8002/health', timeout=4).status == 200 else 1)"

# Build the index (G0 scan when INGEST_GUARD=on), then serve.
CMD ["sh", "-c", "python -m demo_rag.ingest --guard ${INGEST_GUARD:-on} --report && uvicorn demo_rag.app.main:app --host 0.0.0.0 --port 8002"]
