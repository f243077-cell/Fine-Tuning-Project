FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# guard/ imports only training/normalize.py from the repo (Architecture.md section 5).
COPY training/__init__.py training/normalize.py training/
COPY guard/ guard/

RUN useradd --create-home --uid 1000 guard && mkdir -p /data && chown guard /data
USER guard

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=4).status == 200 else 1)"

CMD ["uvicorn", "guard.app.main:app", "--host", "0.0.0.0", "--port", "8001"]
