# Copy to .env and fill in. Never commit .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# guard-api
GUARD_API_KEY=change-me
AUDIT_SALT=change-me-long-random-string
OLLAMA_URL=http://localhost:11434
GUARD_MODEL=ru-guard-1.5b-v2
FAIL_MODE=closed
MODE=enforce
DB_PATH=./guard.db
# Optional (defaults shown)
# OLLAMA_TIMEOUT=30
# OLLAMA_KEEP_ALIVE=30m
# WINDOW_CHARS=1000
# OVERLAP_CHARS=200
# MAX_CHARS=12000
# MAX_BATCH_ITEMS=32
# MAX_BODY_BYTES=2000000
# SCAN_CONCURRENCY=2
# RATE_LIMIT=120/minute
# OTEL_CONSOLE=false

# demo_rag (Phase 7)
GUARD_URL=http://localhost:8001
CHAT_MODEL=qwen2.5:1.5b-instruct
GUARD_ENABLED=true
ALLOW_GUARD_TOGGLE=false
